# coverage.py の設定。
#
# `source = .` を使うのがポイント。単に「テストが実行した行」だけでなく、
# 「テストが一度も import すらしていない本体モジュール」も分母に含めて
# 0% として数えたいので、omit で対象外を削った上でリポジトリ全体を
# source に指定している（omit だけで絞ると、import されないモジュールが
# 集計から丸ごと消えて実態より良い数字が出てしまう）。
#
# 計測対象は本体コード（ルート直下の .py、services/、commands/、webapp/、
# webapp_admin/）のみ。tests/・tools/・migrations/・scripts/ は本体コードの
# テスト対象ではないので除外する。
[run]
source = .
omit =
    tests/*
    tools/*
    migrations/*
    scripts/*
    */__pycache__/*
    .venv/*
    venv/*
    env/*

[report]
show_missing = True
skip_empty = True
precision = 2

# 下限。ここを割ると coverage report が異常終了し、CI が落ちる。
#
# 「下げない」ための歯止めであって、目標値ではない。テストを足したら、この
# 数字も上げること。
#
# 実測に張り付けず空けてある理由が変わった。以前は「ローカル（3.13）と
# CI（3.11）でバージョン依存の分岐が入れ替わる」ためで 2 ポイント空けていたが、
# **本番・CI・手元をすべて 3.13 へ揃えたのでその差は無くなった。** 残るのは
# ローカル（Windows）と CI（ubuntu）の差で、こちらは ffmpeg のビルド違いや
# パス処理の分岐で今も動く。1 ポイントだけ空けてある。
#
#   46.14% のとき 44 → webapp/ のテストを足して 50.09% になったので 48 へ
#   → user_state / api.sql / server_commands / djaudio へテストを足して
#     58.34% になったので 56 へ
#   → webapp / events へテストを足して 66.13% になったので 64 へ
#   → 共有キャッシュ（services/shared_cache.py 93.20% / webapp/cache.py 98.53%）
#     のテストを足して 75.12% になったので 73 へ
#   → メトリクスと共有レート制限のテストを足して 75.45%、かつ Python を 3.13 へ
#     揃えて版差が消えたので 74 へ（空ける理由は上記のとおり OS 差のみになった）
fail_under = 74

[html]
directory = htmlcov
